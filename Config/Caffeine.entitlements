<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. Nothing else is needed: power assertions
         and SMAppService.mainApp work without extra entitlements, and the app
         makes no network, file, or hardware access. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
